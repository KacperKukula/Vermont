{
  "ui": "tui",
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "check": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "cache": false },
    "build:contracts": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DATABASE_LOGIN", "DATABASE_PASSWORD"]
    },
    "db:generate": { "cache": false },
    "db:validate": { "cache": false },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "DATABASE_LOGIN", "DATABASE_PASSWORD"]
    }
  }
}
