{
  "ui": "tui",
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "check": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "cache": false }
  }
}
