{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "esModuleInterop": true, "skipLibCheck": true,
    "outDir": "dist", "rootDir": "src", "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
